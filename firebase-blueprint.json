{
  "entities": {
    "Ad": {
      "title": "Ad",
      "description": "Advertisement banner data",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "type": { "type": "string", "enum": ["image", "video", "code"] },
        "content": { "type": "string", "description": "URL for image/video or HTML/JS code" },
        "link": { "type": "string", "description": "Optional redirect link for image/video" },
        "active": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "type", "content", "active", "createdAt"]
    }
  },
  "firestore": {
    "ads": {
      "schema": "Ad",
      "description": "Collection of advertisement banners"
    }
  }
}
